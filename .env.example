# Copy to .env in the repository root. Defaults work without this file.
# Only HTTP loopback URLs are allowed. No cloud inference.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT_SECONDS=5
# Whole classification deadline, including model loading (10–300 seconds).
CLASSIFICATION_TIMEOUT_SECONDS=120
# Whole reply-plan inference deadline (10–300 seconds).
REPLY_TIMEOUT_SECONDS=120
# Relative paths resolve from the repository root.
DATABASE_PATH=./data/opspilot.db
# Vite proxies /api to this local backend. Restart Vite after changes.
BACKEND_URL=http://127.0.0.1:8000
